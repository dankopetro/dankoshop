{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "build/**"] },
    "dev": { "cache": false, "persistent": true },
    "sync:excel": { "cache": false },
    "seed": { "cache": false },
    "lint": { "outputs": [] },
    "typecheck": { "outputs": [] }
  },
  "globalEnv": ["NODE_ENV"]
}